<header class="header">
  <div class="logo">
    <img
      src="/icons/lock.svg"
      alt=""
      width="25"
      height="25" />
  </div>
  <div class="title-container">
    <!-- Title -->
    <a href="/">
      <h1 class="title">Cloak & Cipher</h1>
    </a>
  </div>

  <!-- Menu -->
  <ul class="menu">
    <li class="menu__item"><a href="/messages">Message Board</a></li>
    <li><a class="menu__link" href="/club">Join Club</a></li>
    <% if(locals.currentUser) { %>
      <li><a class="menu__link" href="/messages/new">New Message</a></li>
      <li class="menu__item"><a class="menu__link" href=""><%= currentUser.username %></a></li>
      <li>
        <form action="/logOut" method="post">
          <button class="logout" type="submit">Log Out</button>
        </form>
			</li>
    <% } else { %>
      <li class="menu__item"><a class="menu__link" href="/logIn">Log In</a></li>
    <% } %>
  </ul>
</header>
