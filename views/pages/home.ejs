<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <!-- Main content-->
    <main class="main">
      <% if(!locals.currentUser) { %>
        <%- include('../partials/hero.ejs') %>
      <% } %>
      <div class="messages">
        <h2>Recent Posts</h2>
        <% if (locals.messages) { %>
          <!-- <h3>Messages</h3> -->
          <% if(messages.length > 0) { %>
            <ul class="messages__list">
            <% messages.forEach(message => { %>
              <li class="message">
                <h4><%= message.title %></h4>
                <p><%= message.content %></p>
                <% if(locals.currentUser) { %>
                  <% if(currentUser.is_member) { %>
                  <p><%= message.author %></p>
                  <% const date = new Date(message.date_added) %>
                  <time datetime="<%= date.toISOString().split('T')[0] %>">
                    Date Added <%= date.toLocaleDateString()  %>
                  </time>
                  <% if(currentUser.is_admin) { %>
                    <!-- Delete message -->
                    <form action="/messages/<%= message.msgId %>/delete" method="POST" >
                      <button type="submit" >Delete</button>
                    </form>
                  <% } %>         
                <% } %>
                <% } %>     
              </li>
            <% }) %>
            </ul>
          <% } else { %>
            <p>No messages yet</p>
          <% } %>
        <% } %>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>
  </body>
</html>
