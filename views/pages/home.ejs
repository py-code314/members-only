<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <!-- Main content-->
    <main class="main">
      <% if(!locals.currentUser) { %>
        <%- include('../partials/hero.ejs') %>
      <% } %>
      <div class="messages">
        <h2>Recent Posts</h2>
        <% if (locals.messages) { %>
          <!-- <h3>Messages</h3> -->
          <% if(messages.length > 0) { %>
            <ul class="messages__list">
            <% messages.forEach(message => { %>
              <li class="message">
                <h3><%= message.title %></h3>
                <% if(locals.currentUser) { %>
                  <% if(currentUser.is_admin) { %>
                    <!-- Delete message -->
                    <form action="/messages/<%= message.msgId %>/delete" method="POST" >
                      <button type="submit" >Delete</button>
                    </form>
                  <% } %>
                <% } %>
                <hr>
                <p><span>Message</span><span><%= message.content %></span></p>
                <% if(locals.currentUser) { %>
                  <% if(currentUser.is_member) { %>
                  <p><span>Author</span><%= message.fullName %></p>
                  <% const date = new Date(message.date_added) %>
                  <time datetime="<%= date.toISOString().split('T')[0] %>">
                    Created <%= date.toLocaleString()  %>
                  </time>
                           
                <% } %>
                <% } %>     
              </li>
            <% }) %>
            </ul>
          <% } else { %>
            <p>No messages yet</p>
          <% } %>
        <% } %>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>
  </body>
</html>
