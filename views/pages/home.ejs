<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <!-- Main content-->
    <main class="main">
      <div>

        <% if(!locals.currentUser) { %>
          <%- include('../partials/hero.ejs') %>
        <% } %>

        <!-- Show success message -->
        <% if(locals.successMember || locals.successAdmin || locals.isMember || locals.isAdmin) { %>
          <%- include('../partials/success.ejs') %>
        <% }  %>

        <div class="messages">
          <h2 class="messages__sub-title" >Recent Posts</h2>

          <% if (locals.messages) { %>
            <% if(messages.length > 0) { %>
              <ul class="messages__list">
              <% messages.forEach(message => { %>
                <li class="message">
                  <div class="message__header">
                    <h3 class="message__title"><%= message.title %></h3>

                    <% if(locals.currentUser) { %>
                      <% if(currentUser.is_admin) { %>
                        <!-- Delete message -->
                        <form action="/messages/<%= message.msgId %>/delete" method="POST" >
                          <button class="btn btn btn--cta" type="submit" >Delete</button>
                        </form>
                      <% } %>
                    <% } %>
                  </div>

                  <hr>

                  <p class="message__item">
                    <span class="message__label">Message</span>
                    <span class="message__text"><%= message.content %></span>
                  </p>

                  <% if(locals.currentUser) { %>
                    <% if(currentUser.is_member) { %>
                      <div class="message__item">
                        <p class="message__label">Author</p>
                        <div class="message__text message__author-container">
                          <p class="message__author"><%= message.fullName %></p>
                          <p>
                            <% if (message.admin) { %>
                              <span class="message__badge message__badge--admin">Admin</span>
                            <% } else if (message.member) { %>
                              <span class="message__badge message__badge--member">Member</span>
                            <% } else { %>
                              <span class="message__badge message__badge--user">User</span>
                            <% } %>
                          </p>
                        </div>
                      </div>

                      <p class="message__item">
                        <span class="message__label">Created</span>
                        <span class="message__date" data-date="<%= message.date_added.toISOString() %>">
                           <%= message.date_added.toUTCString() %>
                        </span>
                      </p>
                    <% } %>
                  <% } %>
                </li>
              <% }) %>
              </ul>
            <% } else { %>
              <p>No messages yet</p>
            <% } %>
          <% } %>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>


  </body>

  <script>

  const dates = document.querySelectorAll('.message__date')
  dates.forEach(el => {
    const dateISO = el.getAttribute('data-date')
    // Convert the date into local date and time
    el.textContent = new Date(dateISO).toLocaleString()
  })
  
  </script>
</html>
