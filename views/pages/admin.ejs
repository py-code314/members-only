<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <!-- Main content-->
    <main class="main">
      <div class="wrapper">
        <div class="admin">
          <section class="admin__description">
            <h2>Become an Admin</h2>
            <p>The Admin serves as the platform's primary steward, ensuring a high-trust environment through rigorous system oversight. Key duties include safeguarding encryption protocols, managing forum infrastructure, and conducting regular privacy audits to maintain a zero-log status. By managing access control and upholding community guidelines, the Admin ensures the network remains a secure, high-quality sanctuary for the private exchange of ideas.</p>
            <p><strong>Remember that "With great power comes great responsibility!"</strong></p>
          </section>

          <hr>
          
          <section class="admin__form">
            <h2>Command Override Terminal</h2>
            <!-- Show errors -->
            <% if(locals.errors) { %>
              <%- include('../partials/errors.ejs') %>
            <% }  %>
        
            <form class="form" action="/admin" method="POST">
              <div class="form__control">
                <label class="form__label" for="passcode">Enter secret passcode</label>
                <input
                  class="form__input"
                  id="passcode"
                  name="passcode"
                  placeholder="Secret passcode..."
                  type="password"
                  required
                  autofocus
                   />
              </div>
              <div class="form__control">
                <input
                  id="show"
                  type="checkbox"
                  onclick="showPasscode()"
                   />
                <label for="show">Show passcode</label>
              </div>
              <button class="btn btn--cta btn--form" type="submit">Submit</button>
            </form>
          </section>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>

    <script>
      function showPasscode() {
        const passcode = document.querySelector('#passcode')
        if(passcode.type === 'password') {
          passcode.type = 'text'
        } else {
          passcode.type = 'password'
        }
      }
    </script>
  </body>
</html>
