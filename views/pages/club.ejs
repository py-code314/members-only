<!DOCTYPE html>
<html lang="en">
  <!-- Head -->
  <%- include('../partials/head.ejs') %>
  <body>
    <!-- Header -->
    <%- include('../partials/header.ejs') %>

    <!-- Main content-->
    <main class="main">
      <div class="club">
        <h2>Join The Inner Circle</h2>
        <!-- Show errors -->
        <% if(locals.errors) { %>
          <%- include('../partials/errors.ejs') %>
        <% }  %>
        
        <form class="form" action="/club" method="POST">
          <div class="form__control">
            <label for="passphrase">Enter secret passphrase</label>
            <input
              id="passphrase"
              name="passphrase"
              placeholder="Secret passphrase..."
              type="password"
              required
              autofocus
               />
          </div>
          <div class="form__control">
            <input
              id="show"
              type="checkbox"
              onclick="showPassphrase()"
               />
            <label for="show">Show passphrase</label>
          </div>
          <button type="submit">Submit</button>
        </form>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer.ejs') %>

    <script>
      function showPassphrase() {
        const passphrase = document.querySelector('#passphrase')
        if(passphrase.type === 'password') {
          passphrase.type = 'text'
        } else {
          passphrase.type = 'password'
        }
      }
    </script>
  </body>
</html>
